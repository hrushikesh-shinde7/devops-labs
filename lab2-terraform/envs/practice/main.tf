# ---------------------------------------------------------------------------
# PRACTICE ENVIRONMENT — costs nothing, teaches the workflow.
# Uses only local/random providers. No cloud account needed.
# ---------------------------------------------------------------------------

terraform {
  required_version = ">= 1.9.0"

  required_providers {
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
  }
}

# ---------------------------------------------------------------------------
# Variables
# ---------------------------------------------------------------------------

variable "environment" {
  description = "Environment name"
  type        = string
  default     = "practice"

  validation {
    condition     = contains(["practice", "dev", "stage", "prod"], var.environment)
    error_message = "environment must be practice, dev, stage or prod."
  }
}

# EXERCISE 4: remove the MIDDLE element ("worker") and run `terraform plan`.
# Watch every resource after the removed index get destroyed and recreated.
variable "count_services" {
  description = "Services created with count — indexed by position (fragile)"
  type        = list(string)
  default     = ["api", "worker", "scheduler"]
}

# EXERCISE 4 (part 2): remove "worker" here too. Only that one is affected.
variable "foreach_services" {
  description = "Services created with for_each — keyed by identity (stable)"
  type        = list(string)
  default     = ["api", "worker", "scheduler"]
}

# ---------------------------------------------------------------------------
# Locals — computed once, reused
# ---------------------------------------------------------------------------

locals {
  name_prefix = "hotelops-${var.environment}"

  common_tags = {
    environment = var.environment
    managed_by  = "terraform"
  }
}

# ---------------------------------------------------------------------------
# count vs for_each — the whole point of this environment
# ---------------------------------------------------------------------------

# ❌ count: addressed by INDEX. Removing a middle element shifts everything after it.
resource "random_pet" "count_demo" {
  count     = length(var.count_services)
  prefix    = var.count_services[count.index]
  separator = "-"
  length    = 2
}

# ✅ for_each: addressed by KEY. Removing one affects only that one.
resource "random_pet" "service_names" {
  for_each  = toset(var.foreach_services)
  prefix    = each.value
  separator = "-"
  length    = 2
}

# ---------------------------------------------------------------------------
# Conditional creation — the legitimate use of count
# ---------------------------------------------------------------------------

resource "random_password" "admin" {
  count   = var.environment == "prod" ? 1 : 0
  length  = 24
  special = true
}

# ---------------------------------------------------------------------------
# Secrets land in state IN PLAINTEXT — EXERCISE 2 proves it
# ---------------------------------------------------------------------------

resource "random_password" "db" {
  length  = 32
  special = true
}

# ---------------------------------------------------------------------------
# Local files — gives us something to delete for the drift exercise (3)
# ---------------------------------------------------------------------------

resource "local_file" "service_config" {
  for_each = random_pet.service_names

  filename = "${path.module}/generated/${each.key}.conf"
  content  = <<-EOT
    # generated by terraform — do not edit
    service     = "${each.key}"
    instance    = "${each.value.id}"
    environment = "${var.environment}"
  EOT

  file_permission = "0644"
}

# ---------------------------------------------------------------------------
# Outputs
# ---------------------------------------------------------------------------

output "service_instances" {
  description = "Stable, key-addressed service names"
  value       = { for k, v in random_pet.service_names : k => v.id }
}

output "count_instances" {
  description = "Index-addressed names — fragile to list reordering"
  value       = random_pet.count_demo[*].id
}

output "sensitive_value" {
  description = "EXERCISE 2: marked sensitive here, but PLAINTEXT in terraform.tfstate"
  value       = random_password.db.result
  sensitive   = true
}
